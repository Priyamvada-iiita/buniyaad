{
  "redirects": [
    {
      "source": "/downloads/buniyaad.apk",
      "destination": "/downloads/buniyaad-marketplace.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"buniyaad-marketplace.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
