# ─── Required ───────────────────────────────────────────────────────────────

# Public site URL (Vercel). Used for Capacitor Android APK + OAuth redirects.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Secret admin console path segment (NOT linked on public site).
# Admin URL: https://yoursite.com/internal/YOUR_ADMIN_PATH/login
# Pick something long and random, e.g. buniyaad-ops-x7k9m2
ADMIN_PATH=buniyaad-ops-change-me

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — https://dashboard.razorpay.com → Settings → API Keys (TEST mode first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Optional — Help chatbot AI ─────────────────────────────────────────────
# Without these, the bot answers built-in FAQs only.
# Open-ended questions get a friendly "robot is sick / LLM down" message.
#
# Local dev (Ollama installed):  OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker with --profile ai:      OLLAMA_BASE_URL=http://ollama:11434
# Vercel production:             point to a hosted Ollama/OpenAI-compatible URL (not localhost)
#
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
